return {
  ------------------------------------------------
  -- Neovim Git 集成插件
  ------------------------------------------------
  "lewis6991/gitsigns.nvim",
  --event = { "BufReadPre", "BufNewFile" },
  event = {"VeryLazy"},
  dependencies = { "nvim-lua/plenary.nvim" },
  opts = {
    --icons eg: '❚' '┃',
    signs = {
      add          = { text = "❚" },
      change       = { text = "❚" },
      delete       = { text = "_" },
      topdelete    = { text = "‾" },
      changedelete = { text = "~" },
      untracked    = { text = "┆" },
    },
    signs_staged = {
      add          = { text = '┃' },
      change       = { text = '┃' },
      delete       = { text = '_' },
      topdelete    = { text = '‾' },
      changedelete = { text = '~' },
      untracked    = { text = '┆' },
    },
    signcolumn = true,  -- 始终显示标记列
    numhl      = false, -- 不要用行号高亮
    linehl     = false, -- 不要用行高亮
    watch_gitdir = {
      interval = 2000,  -- 文件监视间隔（ms）
      follow_files = true,
    },

    attach_to_untracked = false, -- 显示未跟踪文件的标记
    current_line_blame  = true,  -- 默认关闭当前行 blame
    current_line_blame_opts = {
      virt_text = true, -- 虚拟文本显示
      virt_text_pos = "eol",
      delay = 300, -- 延迟显示（ms）默认1000ms
      ignore_whitespace = false,    -- 是否忽略空白修改
      virt_text_priority = 100,
      use_focus = true,
    },
    current_line_blame_formatter = ' >>> <author>, <author_time:%R> - <summary> <abbrev_sha>',

    update_debounce = 200,      -- 降低标记列更新频率（默认 100ms）
    _threaded_diff = true,     -- 启用异步差异计算（Neovim 0.10+）
    --excluded_filetypes = { "alpha", "dashboard", "NvimTree" },
  },

  config = function(_, opts)
    require("gitsigns").setup(opts)

    ------------------------------------------------
    -- blame 颜色
    ------------------------------------------------
    vim.api.nvim_set_hl(0, "GitSignsCurrentLineBlame", {
      fg = "#777777",
      italic = true
    })

    ------------------------------------------------
    -- 折叠寒素，只需定义一次 
    ------------------------------------------------
    _G.GitFoldExpr = function(lnum)
      local line = vim.fn.getline(lnum)
      if line:match("^diff %-%-git ") then
        return ">1"
      end
      return "="
    end

    _G.GitFoldText = function()
      local first = vim.fn.getline(vim.v.foldstart)
      local fname = first:match("^diff %-%-git%s+a/(.-)%s+b/")
      if fname then
        return "+-- " .. fname .. " | " .. (vim.v.foldend - vim.v.foldstart + 1) .. " "
      end
      return vim.fn.getline(vim.v.foldstart)
    end

    ------------------------------------------------
    -- 打开当前行 commit diff
    ------------------------------------------------
    local function show_commit_diff()

      local file = vim.fn.expand("%")
      local line = vim.fn.line(".")

      local blame = vim.fn.systemlist(
        "git blame -L " .. line .. "," .. line .. " --porcelain " .. file
      )

      if not blame or #blame == 0 then
        vim.notify("No blame info", vim.log.levels.WARN)
        return
      end

      local sha = blame[1]:match("^([0-9a-f]+)")

      if not sha then
        vim.notify("Failed to get commit sha", vim.log.levels.ERROR)
        return
      end

      local lines = vim.fn.systemlist("git show " .. sha)

      vim.cmd("vsplit")
      vim.cmd("enew")

      local buf = vim.api.nvim_get_current_buf()

      vim.api.nvim_buf_set_lines(buf, 0, -1, false, lines)

      vim.bo.filetype = "git"
      vim.bo.buftype = "nofile"
      vim.bo.bufhidden = "wipe"
      vim.bo.swapfile = false
      vim.bo.buflisted = false
      vim.bo.modifiable = false

      ------------------------------------------------
      -- fold 设置
      ------------------------------------------------
      vim.wo.foldmethod = "expr"
      vim.wo.foldexpr = "v:lua.GitFoldExpr(v:lnum)"
      vim.wo.foldtext = "v:lua.GitFoldText()"
      vim.wo.foldenable = true

      -- 默认全部折叠
      vim.cmd("normal! zM")

    end

    vim.keymap.set("n", "[g", ":Gitsigns prev_hunk<CR>", { noremap = true, silent = true })
    vim.keymap.set("n", "]g", ":Gitsigns next_hunk<CR>", { noremap = true, silent = true })
    vim.keymap.set("n", "<leader>gb", ":Gitsigns blame_line<CR>", { noremap = true, silent = true })    --查看当前行的blame
    vim.keymap.set("n", "<leader>gr", ":Gitsigns reset_hunk<CR>", { noremap = true, silent = true })    --清楚修改
    vim.keymap.set("n", "<leader>gs", ":Gitsigns preview_hunk<CR>", { noremap = true, silent = true })  --查看当前行的改动
    vim.keymap.set('n', '<leader>ga', ":Gitsigns stage_hunk<CR>", { noremap = true, silent = true })    --将当前段git修改 add

    vim.keymap.set("n", "<leader>gc", show_commit_diff, { desc = "Show commit diff (folded)" })

  end,
}
